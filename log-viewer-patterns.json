{
  "xAxisEnabled": false,
  "highlightEnabled": true,
  "timestampRendering": "delta",
  "patterns": [
    {
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}[\\sT]\\d{2}:\\d{2}:\\d{2}\\.?\\d*\\+\\d{2}?\\:\\d{2}?)",
      "style": "hidden",
      "applyWholeLine": false,
      "xAxisEnabled": true
    },
    {
      "pattern": "ERROR",
      "style": "error",
      "applyWholeLine": true,
      "xAxisEnabled": false
    },
    {
      "pattern": "(kernel\\:)",
      "style": "hidden",
      "applyWholeLine": false,
      "xAxisEnabled": false
    },
    {
      "pattern": "([\\s]*11LSZbook[\\s]*)",
      "style": "hidden",
      "applyWholeLine": false,
      "xAxisEnabled": false
    },
    {
      "pattern": "warning",
      "style": "warning",
      "applyWholeLine": true,
      "xAxisEnabled": false
    }
  ]
}